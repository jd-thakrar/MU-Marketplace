@using System.Data
@using System.Text

@{
    ViewBag.PageTitle = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    DataTable recentPending = ViewBag.RecentPending as DataTable;
    DataTable recentReports = ViewBag.RecentReports as DataTable;
    DataTable recentEscrow = ViewBag.RecentEscrow as DataTable;
    DataTable categoryStats = ViewBag.CategoryStats as DataTable;
    DataTable statusStats = ViewBag.StatusStats as DataTable;

    decimal totalSales = ViewBag.TotalSales != null ? Convert.ToDecimal(ViewBag.TotalSales) : 0m;
    decimal heldEscrow = ViewBag.HeldEscrowAmount != null ? Convert.ToDecimal(ViewBag.HeldEscrowAmount) : 0m;
    decimal releasedEscrow = ViewBag.ReleasedEscrowAmount != null ? Convert.ToDecimal(ViewBag.ReleasedEscrowAmount) : 0m;
    decimal refundedAmount = ViewBag.RefundedAmount != null ? Convert.ToDecimal(ViewBag.RefundedAmount) : 0m;
    int refundRequests = ViewBag.RefundRequests != null ? Convert.ToInt32(ViewBag.RefundRequests) : 0;

    int[] statusCounts = new int[5];
    if (statusStats != null)
    {
        foreach (DataRow r in statusStats.Rows)
        {
            int st = Convert.ToInt32(r["Status"]);
            if (st >= 0 && st < 5)
            {
                statusCounts[st] = Convert.ToInt32(r["Total"]);
            }
        }
    }

    var catLabels = new List<string>();
    var catValues = new List<int>();
    if (categoryStats != null)
    {
        foreach (DataRow r in categoryStats.Rows)
        {
            catLabels.Add("'" + HttpUtility.JavaScriptStringEncode(Convert.ToString(r["CategoryName"])) + "'");
            catValues.Add(Convert.ToInt32(r["Total"]));
        }
    }
}

<div class="page-heading">
    <div>
        <h1>Admin Dashboard</h1>
        <p>Live overview of marketplace listings, Stripe escrow, orders, and moderation.</p>
    </div>
    <div class="action-group">
        <a href="@Url.Action("Escrow", "Admin")" class="btn btn-amber">Escrow &amp; Refunds (@refundRequests)</a>
        <a href="@Url.Action("Listings", "Admin", new { status = 0 })" class="btn btn-secondary">Review Pending</a>
        <a href="@Url.Action("Orders", "Admin")" class="btn btn-primary">View Orders</a>
    </div>
</div>

<!-- PRIMARY STATISTICS (4 CLEAN CARDS) -->
<div class="stats-grid">

    <div class="stat-card" style="border-top:2px solid #333;">
        <div class="stat-icon" style="background:#141414; color:#EDEDED; border:1px solid #262626;">&#8377;</div>
        <div class="stat-info">
            <small>Net Sales Volume</small>
            <h2>&#8377;@totalSales.ToString("N0")</h2>
            <small style="color:#777; font-size:0.75rem;">@ViewBag.TotalOrders active orders</small>
        </div>
    </div>

    <div class="stat-card" style="border-top:2px solid #333;">
        <div class="stat-icon" style="background:#141414; color:#EDEDED; border:1px solid #262626;">&#9203;</div>
        <div class="stat-info">
            <small>Held in Escrow</small>
            <h2>&#8377;@heldEscrow.ToString("N0")</h2>
            <small style="color:#777; font-size:0.75rem;">@refundRequests refund request(s) &middot; &#8377;@releasedEscrow.ToString("N0") paid</small>
        </div>
    </div>

    <div class="stat-card" style="border-top:2px solid #333;">
        <div class="stat-icon" style="background:#141414; color:#EDEDED; border:1px solid #262626;">&#9719;</div>
        <div class="stat-info">
            <small>Pending Listings</small>
            <h2>@ViewBag.PendingListings</h2>
            <small style="color:#777; font-size:0.75rem;">@ViewBag.ApprovedProducts live listings</small>
        </div>
    </div>

    <div class="stat-card" style="border-top:2px solid #333;">
        <div class="stat-icon" style="background:#141414; color:#EDEDED; border:1px solid #262626;">&#9873;</div>
        <div class="stat-info">
            <small>Open Reports</small>
            <h2>@ViewBag.OpenReports</h2>
            <small style="color:#777; font-size:0.75rem;">@ViewBag.TotalStudents students</small>
        </div>
    </div>

</div>

@if (recentEscrow != null && recentEscrow.Rows.Count > 0)
{
    <div class="panel-card" style="margin-bottom:20px;">
        <div class="panel-header">
            <h3>Active Escrow &amp; Refund Queue</h3>
            <a href="@Url.Action("Escrow", "Admin")" class="btn btn-amber btn-sm">Open Escrow Panel</a>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Product</th>
                            <th>Buyer &rarr; Seller</th>
                            <th>Amount</th>
                            <th>Status / Reason</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow er in recentEscrow.Rows)
                        {
                            int es = Convert.ToInt32(er["EscrowStatus"]);
                            <tr>
                                <td><strong>#@er["PurchaseId"]</strong></td>
                                <td>@er["ProductTitle"]</td>
                                <td>@er["BuyerName"] &rarr; @er["SellerName"]</td>
                                <td>&#8377;@Convert.ToDecimal(er["PurchasePrice"]).ToString("N2")</td>
                                <td>
                                    <span class="status-badge status-pending">
                                        @(es == 2 ? "Refund Requested" : "Held in Escrow")
                                    </span>
                                    @if (er["RefundReason"] != DBNull.Value && !string.IsNullOrWhiteSpace(Convert.ToString(er["RefundReason"])))
                                    {
                                        <div style="font-size:0.78rem; color:#F5A623; margin-top:4px;">@er["RefundReason"]</div>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Escrow", "Admin", new { status = es })" class="btn btn-secondary btn-sm">Review &rarr;</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- DOWNLOADABLE REPORTS BAR -->
<div class="export-bar">
    <div>
        <h3>Downloadable Reports (CSV)</h3>
        <p>Export live marketplace data for Excel, Google Sheets, or college project documentation.</p>
    </div>
    <div class="action-group">
        <a href="@Url.Action("ExportOrdersCsv", "Admin")" class="btn btn-amber btn-sm">&#8681; Orders CSV</a>
        <a href="@Url.Action("ExportListingsCsv", "Admin")" class="btn btn-secondary btn-sm">&#8681; Listings CSV</a>
        <a href="@Url.Action("ExportUsersCsv", "Admin")" class="btn btn-secondary btn-sm">&#8681; Students CSV</a>
        <a href="@Url.Action("ExportReportsCsv", "Admin")" class="btn btn-secondary btn-sm">&#8681; Reports CSV</a>
    </div>
</div>

<!-- CHARTS -->
<div class="dashboard-grid">

    <div class="panel-card">
        <div class="panel-header">
            <h3>Listings by Moderation Status</h3>
            <span class="panel-count">Live Breakdown</span>
        </div>
        <div class="panel-body">
            <div class="chart-box">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <h3>Listings per Category</h3>
            <span class="panel-count">All Categories</span>
        </div>
        <div class="panel-body">
            <div class="chart-box">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- RECENT ACTIVITY -->
<div class="dashboard-grid">

    <div class="panel-card">
        <div class="panel-header">
            <h3>Recent Pending Listings</h3>
            <a href="@Url.Action("Listings", "Admin", new { status = 0 })" class="btn btn-secondary btn-sm">View All</a>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="admin-table" style="min-width:420px;">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Seller</th>
                            <th>Price</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentPending != null && recentPending.Rows.Count > 0)
                        {
                            foreach (DataRow row in recentPending.Rows)
                            {
                                <tr>
                                    <td>
                                        <strong>@row["Title"]</strong><br />
                                        <small>@row["CategoryName"]</small>
                                    </td>
                                    <td>@row["SellerName"]</td>
                                    <td>&#8377;@Convert.ToDecimal(row["Price"]).ToString("N0")</td>
                                    <td>@Convert.ToDateTime(row["CreatedAt"]).ToString("dd MMM")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align:center;padding:24px;color:#5B6270;">
                                    No pending listings right now.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <h3>Recent Open Reports</h3>
            <a href="@Url.Action("Reports", "Admin", new { statusFilter = "pending" })" class="btn btn-secondary btn-sm">View All</a>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="admin-table" style="min-width:420px;">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Reporter</th>
                            <th>Reason</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentReports != null && recentReports.Rows.Count > 0)
                        {
                            foreach (DataRow row in recentReports.Rows)
                            {
                                <tr>
                                    <td><strong>@row["ProductTitle"]</strong></td>
                                    <td>@row["ReporterName"]</td>
                                    <td>@row["Reason"]</td>
                                    <td>@Convert.ToDateTime(row["CreatedAt"]).ToString("dd MMM")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align:center;padding:24px;color:#5B6270;">
                                    No open reports right now.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            Chart.defaults.color = '#A1A1AA';
            Chart.defaults.borderColor = '#262626';

            var statusCtx = document.getElementById('statusChart');
            if (statusCtx) {
                new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Pending', 'Approved', 'Rejected', 'Sold', 'Removed'],
                        datasets: [{
                            data: [@statusCounts[0], @statusCounts[1], @statusCounts[2], @statusCounts[3], @statusCounts[4]],
                            backgroundColor: ['#F5A623', '#50E3C2', '#FF4D4F', '#3291FF', '#52525B'],
                            borderWidth: 2,
                            borderColor: '#0A0A0A'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: {
                            legend: { position: 'bottom', labels: { color: '#A1A1AA', boxWidth: 10, padding: 14 } }
                        }
                    }
                });
            }

            var catCtx = document.getElementById('categoryChart');
            if (catCtx) {
                new Chart(catCtx, {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(", ", catLabels))],
                        datasets: [{
                            label: 'Listings',
                            data: [@string.Join(", ", catValues)],
                            backgroundColor: '#EDEDED',
                            hoverBackgroundColor: '#3291FF',
                            borderRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0, color: '#94A3B8' } },
                            x: { grid: { display: false }, ticks: { color: '#94A3B8' } }
                        }
                    }
                });
            }
        })();
    </script>
}
