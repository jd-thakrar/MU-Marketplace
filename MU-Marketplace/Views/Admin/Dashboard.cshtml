@using System.Data
@using System.Text

@{
    ViewBag.PageTitle = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    DataTable recentPending = ViewBag.RecentPending as DataTable;
    DataTable recentReports = ViewBag.RecentReports as DataTable;
    DataTable categoryStats = ViewBag.CategoryStats as DataTable;
    DataTable statusStats = ViewBag.StatusStats as DataTable;

    decimal totalSales = ViewBag.TotalSales != null ? Convert.ToDecimal(ViewBag.TotalSales) : 0m;

    int[] statusCounts = new int[5];
    if (statusStats != null)
    {
        foreach (DataRow r in statusStats.Rows)
        {
            int st = Convert.ToInt32(r["Status"]);
            if (st >= 0 && st < 5)
            {
                statusCounts[st] = Convert.ToInt32(r["Total"]);
            }
        }
    }

    var catLabels = new List<string>();
    var catValues = new List<int>();
    if (categoryStats != null)
    {
        foreach (DataRow r in categoryStats.Rows)
        {
            catLabels.Add("'" + HttpUtility.JavaScriptStringEncode(Convert.ToString(r["CategoryName"])) + "'");
            catValues.Add(Convert.ToInt32(r["Total"]));
        }
    }
}

<div class="page-heading">
    <div>
        <h1>Admin Dashboard</h1>
        <p>Live overview of marketplace listings, orders, students, and moderation.</p>
    </div>
    <div class="action-group">
        <a href="@Url.Action("Listings", "Admin", new { status = 0 })" class="btn btn-amber">Review Pending</a>
        <a href="@Url.Action("Orders", "Admin")" class="btn btn-primary">View Orders</a>
    </div>
</div>

<!-- PRIMARY STATISTICS -->
<div class="stats-grid">

    <div class="stat-card accent-amber">
        <div class="stat-icon gold">&#9719;</div>
        <div class="stat-info">
            <small>Pending Listings</small>
            <h2>@ViewBag.PendingListings</h2>
        </div>
    </div>

    <div class="stat-card accent-green">
        <div class="stat-icon green">&#10003;</div>
        <div class="stat-info">
            <small>Approved Products</small>
            <h2>@ViewBag.ApprovedProducts</h2>
        </div>
    </div>

    <div class="stat-card accent-teal">
        <div class="stat-icon">&#9817;</div>
        <div class="stat-info">
            <small>Total Students</small>
            <h2>@ViewBag.TotalStudents</h2>
        </div>
    </div>

    <div class="stat-card accent-red">
        <div class="stat-icon red">&#9873;</div>
        <div class="stat-info">
            <small>Open Reports</small>
            <h2>@ViewBag.OpenReports</h2>
        </div>
    </div>

</div>

<!-- SECONDARY SUMMARY -->
<div class="stats-grid-3">

    <div class="stat-card accent-teal">
        <div class="stat-icon">&#9733;</div>
        <div class="stat-info">
            <small>Completed Orders</small>
            <h2>@ViewBag.TotalOrders</h2>
        </div>
    </div>

    <div class="stat-card accent-amber">
        <div class="stat-icon gold">&#9776;</div>
        <div class="stat-info">
            <small>Active Categories</small>
            <h2>@ViewBag.ActiveCategories</h2>
        </div>
    </div>

    <div class="stat-card accent-green">
        <div class="stat-icon green">&#8377;</div>
        <div class="stat-info">
            <small>Total Sales Volume</small>
            <h2>&#8377;@totalSales.ToString("N0")</h2>
        </div>
    </div>

</div>

<!-- DOWNLOADABLE REPORTS BAR -->
<div class="export-bar">
    <div>
        <h3>Downloadable Reports (CSV)</h3>
        <p>Export live marketplace data for Excel, Google Sheets, or college project documentation.</p>
    </div>
    <div class="action-group">
        <a href="@Url.Action("ExportOrdersCsv", "Admin")" class="btn btn-amber btn-sm">&#8681; Orders CSV</a>
        <a href="@Url.Action("ExportListingsCsv", "Admin")" class="btn btn-secondary btn-sm">&#8681; Listings CSV</a>
        <a href="@Url.Action("ExportUsersCsv", "Admin")" class="btn btn-secondary btn-sm">&#8681; Students CSV</a>
        <a href="@Url.Action("ExportReportsCsv", "Admin")" class="btn btn-secondary btn-sm">&#8681; Reports CSV</a>
    </div>
</div>

<!-- CHARTS -->
<div class="dashboard-grid">

    <div class="panel-card">
        <div class="panel-header">
            <h3>Listings by Moderation Status</h3>
            <span class="panel-count">Live Breakdown</span>
        </div>
        <div class="panel-body">
            <div class="chart-box">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <h3>Listings per Category</h3>
            <span class="panel-count">All Categories</span>
        </div>
        <div class="panel-body">
            <div class="chart-box">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- RECENT ACTIVITY -->
<div class="dashboard-grid">

    <div class="panel-card">
        <div class="panel-header">
            <h3>Recent Pending Listings</h3>
            <a href="@Url.Action("Listings", "Admin", new { status = 0 })" class="btn btn-secondary btn-sm">View All</a>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="admin-table" style="min-width:420px;">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Seller</th>
                            <th>Price</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentPending != null && recentPending.Rows.Count > 0)
                        {
                            foreach (DataRow row in recentPending.Rows)
                            {
                                <tr>
                                    <td>
                                        <strong>@row["Title"]</strong><br />
                                        <small>@row["CategoryName"]</small>
                                    </td>
                                    <td>@row["SellerName"]</td>
                                    <td>&#8377;@Convert.ToDecimal(row["Price"]).ToString("N0")</td>
                                    <td>@Convert.ToDateTime(row["CreatedAt"]).ToString("dd MMM")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align:center;padding:24px;color:#5B6270;">
                                    No pending listings right now.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="panel-card">
        <div class="panel-header">
            <h3>Recent Open Reports</h3>
            <a href="@Url.Action("Reports", "Admin", new { statusFilter = "pending" })" class="btn btn-secondary btn-sm">View All</a>
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="admin-table" style="min-width:420px;">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Reporter</th>
                            <th>Reason</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentReports != null && recentReports.Rows.Count > 0)
                        {
                            foreach (DataRow row in recentReports.Rows)
                            {
                                <tr>
                                    <td><strong>@row["ProductTitle"]</strong></td>
                                    <td>@row["ReporterName"]</td>
                                    <td>@row["Reason"]</td>
                                    <td>@Convert.ToDateTime(row["CreatedAt"]).ToString("dd MMM")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align:center;padding:24px;color:#5B6270;">
                                    No open reports right now.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;

            var statusCtx = document.getElementById('statusChart');
            if (statusCtx) {
                new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Pending', 'Approved', 'Rejected', 'Sold', 'Removed'],
                        datasets: [{
                            data: [@statusCounts[0], @statusCounts[1], @statusCounts[2], @statusCounts[3], @statusCounts[4]],
                            backgroundColor: ['#FFC107', '#16865B', '#D94B4B', '#00A6B2', '#94A3B8'],
                            borderWidth: 2,
                            borderColor: '#FFFFFF'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '64%',
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 12, padding: 14 } }
                        }
                    }
                });
            }

            var catCtx = document.getElementById('categoryChart');
            if (catCtx) {
                new Chart(catCtx, {
                    type: 'bar',
                    data: {
                        labels: [@Html.Raw(string.Join(", ", catLabels))],
                        datasets: [{
                            label: 'Listings',
                            data: [@string.Join(", ", catValues)],
                            backgroundColor: '#07364B',
                            hoverBackgroundColor: '#FFC107',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0 } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        })();
    </script>
}
