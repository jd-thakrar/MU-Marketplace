
@{
    ViewBag.PageTitle = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading">
    <h1>Admin Dashboard</h1>
    <p>Monitor marketplace activities and manage the platform.</p>
</div>

<!-- STATISTICS -->
<div class="stats-grid">

    <div class="stat-card">
        <div class="stat-icon gold">◷</div>

        <div class="stat-info">
            <small>Pending Listings</small>
            <h2>@ViewBag.PendingListings</h2>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">♙</div>

        <div class="stat-info">
            <small>Total Students</small>
            <h2>@ViewBag.TotalStudents</h2>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon green">✓</div>

        <div class="stat-info">
            <small>Approved Products</small>
            <h2>@ViewBag.ApprovedProducts</h2>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon red">⚑</div>

        <div class="stat-info">
            <small>Open Reports</small>
            <h2>@ViewBag.OpenReports</h2>
        </div>
    </div>

</div>

<!-- QUICK ACTIONS -->
<div class="panel-card">

    <div class="panel-header">
        <h3>Marketplace Management</h3>
    </div>

    <div class="panel-body">

        <p style="color:#718096;margin-top:0;">
            Select a section to manage marketplace activities.
        </p>

        <div style="display:flex;gap:12px;flex-wrap:wrap;">

            <a href="@Url.Action("Listings", "Admin")"
               class="btn btn-primary">
                Manage Listings
            </a>

            <a href="@Url.Action("Users", "Admin")"
               class="btn btn-secondary">
                Manage Users
            </a>

            <a href="@Url.Action("Reports", "Admin")"
               class="btn btn-warning">
                Review Reports
            </a>

        </div>

    </div>

</div>
