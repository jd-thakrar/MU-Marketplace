@model MU_Marketplace.Models.ViewModels.MyListingsPageViewModel
@using MU_Marketplace.Models
@{
    ViewBag.Title = "My Listings";
}

<div class="mp-page-head">
    <div>
        <h2>My Listings</h2>
        <p class="mp-meta">Track your listed items, sales performance, and buyer pickup contacts.</p>
    </div>
    <div class="mp-action-row">
        <a class="mp-btn mp-btn-primary" href="@Url.Action("Create")">+ New listing</a>
    </div>
</div>

@Html.Partial("_Alerts")

<!-- SUMMARY CARDS -->
<div class="mp-summary-grid">
    <div class="mp-summary-card">
        <small>Products Listed</small>
        <strong>@Model.Summary.TotalListed</strong>
    </div>
    <div class="mp-summary-card accent-green">
        <small>Products Sold</small>
        <strong>@Model.Summary.TotalSold</strong>
    </div>
    <div class="mp-summary-card accent-amber">
        <small>Pending Review</small>
        <strong>@Model.Summary.PendingApproval</strong>
    </div>
    <div class="mp-summary-card accent-teal">
        <small>Paid Profit (Released)</small>
        <strong>&#8377;@Model.Summary.TotalRevenue.ToString("N0")</strong>
    </div>
</div>

@if (!Model.Listings.Any())
{
    <p class="mp-empty">You have not listed anything yet.</p>
}
else
{
    <table class="mp-table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Price</th>
                <th>Status</th>
                <th>Listed</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Listings)
        {
            <tr>
                <td>
                    <a href="@Url.Action("Details", new { id = p.ProductId })"><strong>@p.Title</strong></a>
                    <div class="mp-meta">@p.CategoryName &middot; Pick from: @(string.IsNullOrWhiteSpace(p.PickupLocation) ? "MU Campus" : p.PickupLocation)</div>
                </td>
                <td>&#8377;@p.Price.ToString("N2")</td>
                <td><span class="mp-badge mp-@p.Status.ToString().ToLower()">@p.Status</span></td>
                <td>@p.CreatedDate.ToString("dd MMM yyyy")</td>
                <td>
                    @if (p.Status == ProductStatus.Sold)
                    {
                        <div>Buyer: <strong>@p.BuyerName</strong></div>
                        if (!string.IsNullOrWhiteSpace(p.BuyerPhone))
                        {
                            <div class="mp-meta">Phone: <a href="tel:@p.BuyerPhone">@p.BuyerPhone</a></div>
                        }
                        else
                        {
                            <div class="mp-meta">Phone: Not provided</div>
                        }
                        if (!string.IsNullOrWhiteSpace(p.BuyerEmail))
                        {
                            <div class="mp-meta">Email: <a href="mailto:@p.BuyerEmail">@p.BuyerEmail</a></div>
                        }
                        if (p.EscrowStatus.HasValue)
                        {
                            string escrowLabel =
                                p.EscrowStatus == EscrowStatus.Released ? "Payout Released (Added to Profit)" :
                                p.EscrowStatus == EscrowStatus.RefundRequested ? "Refund Requested (Admin Review)" :
                                p.EscrowStatus == EscrowStatus.Refunded ? "Refunded to Buyer" :
                                "Held in Escrow (Awaiting Buyer)";
                            string escrowClass =
                                p.EscrowStatus == EscrowStatus.Released ? "mp-approved" :
                                p.EscrowStatus == EscrowStatus.Refunded ? "mp-rejected" : "mp-pending";
                            <div style="margin-top:6px"><span class="mp-badge @escrowClass">@escrowLabel</span></div>
                            if (p.EscrowStatus == EscrowStatus.Held || p.EscrowStatus == EscrowStatus.RefundRequested)
                            {
                                <div style="margin-top:8px">
                                    @using (Html.BeginForm("SellerCancelOrder", "Marketplace", new { id = p.ProductId }, FormMethod.Post,
                                           new { @class = "mp-inline", onsubmit = "return confirm('Cancel this order, refund the buyer, and re-list this item on the marketplace?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="mp-btn mp-btn-danger">Cancel Order &amp; Re-list</button>
                                    }
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <a class="mp-btn" href="@Url.Action("Edit", new { id = p.ProductId })">Edit</a>
                        using (Html.BeginForm("Remove", "Marketplace", new { id = p.ProductId }, FormMethod.Post,
                               new { @class = "mp-inline", onsubmit = "return confirm('Remove this listing?');" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="mp-btn mp-btn-danger">Remove</button>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
