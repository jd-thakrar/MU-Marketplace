@model MU_Marketplace.Models.ViewModels.ProductFormViewModel

@Html.ValidationSummary(true, "", new { @class = "mp-error" })
@Html.HiddenFor(m => m.ProductId)

<div class="mp-field">
    @Html.LabelFor(m => m.Title)
    @Html.TextBoxFor(m => m.Title, new { @class = "mp-input", maxlength = 150 })
    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "mp-error" })
</div>

<div class="mp-field">
    @Html.LabelFor(m => m.CategoryId)
    @Html.DropDownListFor(m => m.CategoryId, Model.Categories, "-- Select category --", new { @class = "mp-input" })
    @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "mp-error" })
</div>

<div class="mp-field">
    @Html.LabelFor(m => m.Price)
    @Html.TextBoxFor(m => m.Price, new { @class = "mp-input", type = "number", min = "1", step = "0.01" })
    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "mp-error" })
</div>

<div class="mp-field">
    @Html.LabelFor(m => m.ProductCondition)
    @Html.DropDownListFor(m => m.ProductCondition, new[]
    {
        new SelectListItem { Text = "New", Value = "0" },
        new SelectListItem { Text = "Like New", Value = "1" },
        new SelectListItem { Text = "Good", Value = "2" },
        new SelectListItem { Text = "Fair", Value = "3" }
    }, new { @class = "mp-input" })
    @Html.ValidationMessageFor(m => m.ProductCondition, "", new { @class = "mp-error" })
</div>

<div class="mp-field">
    @Html.LabelFor(m => m.PickupLocation)
    @Html.TextBoxFor(m => m.PickupLocation, new { @class = "mp-input", maxlength = 150, placeholder = "e.g. Main Block Lobby, Library Entrance" })
    @Html.ValidationMessageFor(m => m.PickupLocation, "", new { @class = "mp-error" })
</div>

<div class="mp-field">
    @Html.LabelFor(m => m.Description)
    @Html.TextAreaFor(m => m.Description, 5, 40, new { @class = "mp-input", maxlength = 2000 })
    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "mp-error" })
</div>
